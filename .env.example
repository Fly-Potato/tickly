# Compose 内 API 必须监听容器网络可访问的地址，通常保持 0.0.0.0。
TICKLY_HOST=0.0.0.0
TICKLY_PORT=8321
# Compose 生产模式必须显式提供至少 32 字符的随机 JWT 密钥。
TICKLY_JWT_SECRET=replace-with-at-least-32-random-characters
TICKLY_REFRESH_COOKIE_SECURE=true

# 原始 Token 只保存在 Codex 主机；这里填写其小写 SHA-256，不要填写原始 Token。
TICKLY_MCP_TOKEN_SHA256=replace-with-lowercase-sha256-hex
TICKLY_MCP_PORT=8322
# 生产部署时把本机值替换为实际可信入口的 Host 与 Origin。
TICKLY_MCP_ALLOWED_HOSTS=["localhost:*","127.0.0.1:*"]
TICKLY_MCP_ALLOWED_ORIGINS=["http://localhost:*","http://127.0.0.1:*"]
