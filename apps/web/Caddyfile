:8080 {
	encode zstd gzip

	# 内部 API 永不对外暴露；handle 保证命中后不会继续落入 SPA fallback。
	@internal path /internal/*
	handle @internal {
		respond 404
	}

	@mcp path /mcp /mcp/*
	handle @mcp {
		reverse_proxy mcp:{$TICKLY_MCP_PORT}
	}

	@api path /api/* /health /ready
	handle @api {
		reverse_proxy api:{$TICKLY_API_PORT}
	}

	handle {
		root * /srv
		route {
			try_files {path} /index.html
			header /index.html Cache-Control "public, max-age=0, must-revalidate"
			file_server
		}
	}
}
